{
  "name": "one-platform",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "prettier --check . && astro check",
    "format": "prettier --write .",
    "update:agent": "pnpm exec db-ux-agent-cli .",
    "lint": "pnpm run \"/lint:.*/\"",
    "lint:eslint": "eslint \"**/*.{js,ts,tsx,astro}\"",
    "lint:stylelint": "stylelint \"**/*.css\" --ignore-path .stylelintignore",
    "lint:visuals": "node scripts/visuals/optimize-visuals.ts --check",
    "cache:figma": "node scripts/cache-figma-images.ts",
    "optimize:visuals": "node scripts/visuals/optimize-visuals.ts",
    "decode-db-theme-assets": "node decode-db-assets.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:regenerate": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.3",
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@db-ux/agent-cli": "6.0.0",
    "@db-ux/core-components": "6.0.0",
    "@db-ux/core-eslint-plugin": "6.0.0",
    "@db-ux/core-foundations": "6.0.0",
    "@db-ux/core-stylelint": "6.0.0",
    "@db-ux/db-theme": "7.2.0",
    "@db-ux/db-theme-fonts": "2.2.0",
    "@db-ux/db-theme-icons": "4.4.0",
    "@db-ux/db-theme-illustrative-icons": "3.4.0",
    "@db-ux/react-core-components": "6.0.0",
    "@double-great/stylelint-a11y": "3.5.4",
    "@orama/orama": "3.1.18",
    "@orama/plugin-astro": "3.1.18",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.71.0",
    "astro": "7.3.8",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sharp": "0.35.5",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-use-logical": "2.1.3",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "vite-plugin-static-copy": "4.1.1"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
