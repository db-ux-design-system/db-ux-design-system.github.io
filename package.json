{
  "name": "one-platform",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "prettier --check . && astro check",
    "format": "prettier --write .",
    "update:agent": "npx @db-ux/agent-cli .",
    "lint": "pnpm run \"/lint:.*/\"",
    "lint:eslint": "eslint \"**/*.{js,ts,tsx,astro}\"",
    "lint:stylelint": "stylelint \"**/*.css\" --ignore-path .stylelintignore",
    "cache:figma": "node scripts/cache-figma-images.ts",
    "decode-db-theme-assets": "node decode-db-assets.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:regenerate": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@db-ux/agent-cli": "5.6.1",
    "@db-ux/core-components": "5.6.1",
    "@db-ux/core-eslint-plugin": "5.6.1",
    "@db-ux/core-foundations": "5.6.1",
    "@db-ux/core-stylelint": "5.6.1",
    "@db-ux/db-theme": "6.3.0",
    "@db-ux/db-theme-fonts": "2.0.5",
    "@db-ux/db-theme-icons": "4.3.0",
    "@db-ux/db-theme-illustrative-icons": "3.3.1",
    "@db-ux/react-core-components": "5.6.1",
    "@double-great/stylelint-a11y": "3.5.4",
    "@orama/orama": "3.1.18",
    "@orama/plugin-astro": "3.1.18",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.71.0",
    "astro": "7.3.5",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sharp": "0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-use-logical": "2.1.3",
    "typescript": "6.0.3",
    "vite-plugin-static-copy": "4.1.1"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
