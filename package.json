{
  "name": "one-platform",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "prettier --check . && astro check",
    "format": "prettier --write .",
    "update:agent": "npx @db-ux/agent-cli .",
    "lint": "pnpm run \"/lint:.*/\"",
    "lint:eslint": "eslint \"**/*.{js,ts,tsx,astro}\"",
    "lint:stylelint": "stylelint \"**/*.css\" --ignore-path .stylelintignore",
    "cache:figma": "node scripts/cache-figma-images.ts",
    "decode-db-theme-assets": "node decode-db-assets.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:regenerate": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "5.0.6",
    "@astrojs/react": "5.0.5",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "4.12.1",
    "@db-ux/agent-cli": "5.2.1-shell2-b3d6ca4",
    "@db-ux/core-components": "5.2.1-shell2-b3d6ca4",
    "@db-ux/core-eslint-plugin": "5.2.1-shell2-b3d6ca4",
    "@db-ux/core-foundations": "5.2.1-shell2-b3d6ca4",
    "@db-ux/core-stylelint": "5.2.1-shell2-b3d6ca4",
    "@db-ux/db-theme": "6.3.0",
    "@db-ux/db-theme-fonts": "2.0.5",
    "@db-ux/db-theme-icons": "4.3.0",
    "@db-ux/db-theme-illustrative-icons": "3.3.1",
    "@db-ux/react-core-components": "5.2.1-shell2-b3d6ca4",
    "@double-great/stylelint-a11y": "3.5.0",
    "@orama/orama": "3.1.18",
    "@orama/plugin-astro": "3.1.18",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/parser": "8.65.0",
    "astro": "6.3.7",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.4",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-use-logical": "2.1.3",
    "typescript": "6.0.3",
    "vite-plugin-static-copy": "3.3.0"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
