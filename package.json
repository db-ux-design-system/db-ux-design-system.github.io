    "@db-ux/react-core-components": "4.14.0-shell-52d18db",
    "@double-great/stylelint-a11y": "3.5.0",
    "@orama/orama": "3.1.18",
    "@orama/plugin-astro": "3.1.18",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.65.0",
    "astro": "6.3.7",
    "eslint": "10.8.0",
