---
import type { MarkdownHeading } from 'astro';
import { TableOfContents } from '@template/components/TableOfContents';
import { DBSection, DBNotification, type SemanticType } from '@db-ux/react-core-components';
import { PageHero } from '@components';
import ReadingListToggle from '@template/components/ReadingList/ReadingListToggle.tsx';
import { pageId } from '@template/components/ReadingList/reading-list-items';
import { appNavigation } from '@root/app.navigation.ts';
import LearnArticle from '@template/components/Learn/LearnArticle.astro';

interface Props {
	headings: MarkdownHeading[];
	frontmatter: DocumentationFrontMatter;
}

const { headings, frontmatter } = Astro.props as Props;
const toc = (headings?.length ?? 0) > 0 && frontmatter.toc === true;

const badgeMap: Record<string, { text: string; semantic: SemanticType }> = {
	concept: { text: 'Concept', semantic: 'warning' },
	beta: { text: 'Beta', semantic: 'informational' },
	stable: { text: 'Stable', semantic: 'successful' },
	deprecated: { text: 'Deprecated', semantic: 'critical' },
	legacy: { text: 'Legacy', semantic: 'warning' },
	sub: { text: 'Sub', semantic: 'neutral' },
};
const badge = frontmatter.status ? badgeMap[frontmatter.status] : undefined;
const isSub = frontmatter.status === 'sub';
const SUB_PARENT_LABELS: Record<string, string> = {
	'control-panel': 'Control Panel',
	shell: 'Shell',
};
const parentSegment = Astro.url.pathname.split('/').filter(Boolean).at(-2);
const isDE = Astro.url.pathname.startsWith('/de/');
const subParent =
	frontmatter.subParent ??
	(parentSegment
		? (SUB_PARENT_LABELS[parentSegment] ??
			parentSegment.charAt(0).toUpperCase() + parentSegment.slice(1))
		: undefined);

// Reading list: the page is stored by its EN path with the title in both languages.
// The title of the other language comes from the navigation tree, which is built from
// the EN pages and carries the DE title (titleDe) where a DE page exists.
const lang = isDE ? 'de' : 'en';
let readingList: { id: string; title: { en?: string; de?: string } } | undefined;
if (frontmatter.readingList) {
	const id = pageId(Astro.url.pathname);
	const find = (items: NavigationItem[]): NavigationItem | undefined => {
		for (const item of items) {
			if (item.path === id) return item;
			const found = item.children && find(item.children);
			if (found) return found;
		}
		return undefined;
	};
	const node = find(appNavigation);
	const title = { en: node?.title, de: node?.titleDe };
	title[lang] = frontmatter.title ?? frontmatter.headline ?? title[lang];
	readingList = { id, title };
}
---

{toc && (
	<TableOfContents
		client:only="react"
		astro={Astro}
		headings={headings}
		tocMaxDepth={frontmatter.tocMaxDepth}
	/>
)}
<div class="dba-main-content">
	{(frontmatter.headline || frontmatter.description) && (
		<DBSection id={frontmatter.title} width="large" spacing="small">
			<PageHero
				headline={frontmatter.headline}
				description={frontmatter.description}
				badgeText={badge?.text}
				badgeSemantic={badge?.semantic ?? 'adaptive'}
				headlineLevel={frontmatter.headlineLevel ?? 1}
				imageSrc={frontmatter.heroImage}
				imageAlt={frontmatter.heroImageAlt}
				visual={frontmatter.heroVisual}
				visualImage={frontmatter.heroVisualImage}
				align={frontmatter.align}
				toolbar={Boolean(readingList) || frontmatter.stepper === true}
			>
				{readingList && (
					<ReadingListToggle
						slot="toolbar"
						client:load
						lang={lang}
						id={readingList.id}
						title={readingList.title}
					/>
				)}
			</PageHero>
			{isSub && subParent && (
				<DBNotification
					className="sub-component-notice"
					variant="standalone"
					semantic="informational"
					style={{
						maxInlineSize: 'var(--db-container-md)',
						marginBlockStart: 'var(--db-spacing-fixed-md)',
					}}
				>
					{isDE
						? `Dies ist eine Subkomponente von ${subParent} und kann nicht eigenständig verwendet werden.`
						: `This is a subcomponent of the ${subParent} and cannot be used separately.`}
				</DBNotification>
			)}
		</DBSection>
	)}
	<DBSection id="main-content-section" width="large" spacing="none">
		{/* Learn articles with `stepper: true` get the article/stepper wrapper here, so
		    the MDX only contains the blocks and nothing is wired up per article. */}
		{frontmatter.stepper ? (
			<LearnArticle stepper>
				<slot />
			</LearnArticle>
		) : (
			<slot />
		)}
	</DBSection>
</div>
