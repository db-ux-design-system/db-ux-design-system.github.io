---
import type { MarkdownHeading } from 'astro';
import '../../styles/global.css';
import HtmlHead from '@template/components/HtmlHead';
import DocumentationContent from './DocumentationContent.astro';
import { Shell } from '@template/components/Shell';
import Footer from '@template/components/Footer/Footer.astro';
import { appNavigation } from '@root/app.navigation.ts';

interface Props {
	headings: MarkdownHeading[];
	frontmatter: DocumentationFrontMatter;
}
const { headings, frontmatter } = Astro.props;
const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/de/') || currentPath === '/de' ? 'de' : 'en';

// Determine redirect target for hidePage or externalUrl
let redirectUrl: string | undefined;
if (frontmatter.externalUrl) {
	redirectUrl = frontmatter.externalUrl;
} else if (frontmatter.hidePage) {
	if (frontmatter.redirectTo) {
		redirectUrl = frontmatter.redirectTo;
	} else {
		const norm = (p: string) => p.replace(/\/+$/, '');
		const currentNorm = norm(currentPath);
		const findNode = (items: NavigationItem[], parentPath = ''): NavigationItem | undefined => {
			for (const item of items) {
				const itemPath = item.path ? norm('/' + item.path) : null;
				if (itemPath === currentNorm) return item;
				// For hidePage nodes: check if a child path starts with currentNorm
				if (!itemPath && item.children?.length) {
					const firstChildPath = item.children[0]?.path;
					if (firstChildPath && norm('/' + firstChildPath).startsWith(currentNorm + '/')) {
						return item;
					}
				}
				if (item.children) {
					const found = findNode(item.children, item.path || parentPath);
					if (found) return found;
				}
			}
			return undefined;
		};
		const node = findNode(appNavigation);
		const firstChild = node?.children?.[0]?.path;
		if (firstChild) {
			redirectUrl = '/' + firstChild.replace(/\.(md|mdx|astro)$/, '');
		}
	}
}
---

{redirectUrl ? (
	<html lang={lang}>
		<head>
			<meta charset="utf-8" />
			<title>{`Redirecting…`}</title>
			<meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
		</head>
		<body>
			<script define:vars={{ redirectUrl }}>
				window.location.replace(redirectUrl);
			</script>
		</body>
	</html>
) : (
	<html lang={lang}>
		<HtmlHead title={frontmatter.title} loadModelViewer={frontmatter.loadModelViewer} />
		<body>
			<Shell client:only="react" pathname={currentPath}>
				<DocumentationContent frontmatter={frontmatter} headings={headings}>
					<slot />
				</DocumentationContent>
				<Footer slot="endSlot" />
			</Shell>
			<slot name="script" />
			<script>
				import '@template/components/ComponentPlayground/playground-init';
				// Learn articles opt in to a stepper view. The controller is a no-op on
				// pages without a #learn-article, so it is safe to run on every doc page.
				// It lives here, not in the MDX-embedded LearnArticle component, because
				// Astro does not hoist <script> from .astro components used inside MDX.
				import { initLearnArticle } from '@template/components/Learn/learn-controller';
				initLearnArticle();
			</script>
			<!-- Deep-link scroll fix: The Shell renders client-side (client:only="react"),
				     so anchor targets don't exist yet when the browser performs its native
				     hash scroll. This script retries scrolling until the target element
				     appears in the DOM (up to ~3 s), and scrolls again while the layout
				     above it is still settling.
				     It runs on astro:page-load, not only once: after a client-side
				     navigation (ClientRouter) this inline script is not executed again,
				     so links with an anchor from another page landed at the top. The
				     window flag keeps the listener from being registered twice. -->
			<script is:inline>
				(function () {
					if (window.__dbUxHashScroll) return;
					window.__dbUxHashScroll = true;
					var scrollToHash = function () {
						if (!window.location.hash) return;
						var id = decodeURIComponent(window.location.hash.slice(1));
						var attempts = 0;
						var lastTop = null;
						var stopped = false;
						// Stop as soon as the user scrolls or navigates by keyboard,
						// so the retries never fight their own scrolling.
						var stop = function () {
							stopped = true;
						};
						['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (type) {
							window.addEventListener(type, stop, { once: true, passive: true });
						});
						var tick = function () {
							if (stopped) return;
							var el = document.getElementById(id);
							if (el) {
								var top = el.getBoundingClientRect().top;
								if (lastTop === null || Math.abs(top - lastTop) > 1) el.scrollIntoView();
								lastTop = el.getBoundingClientRect().top;
							}
							if (attempts++ < 20) setTimeout(tick, 150);
						};
						setTimeout(tick, 150);
					};
					document.addEventListener('astro:page-load', scrollToHash);
				})();
			</script>
		</body>
	</html>
)}
