---
import { DBCard } from '@db-ux/react-core-components';
import './MaintenanceVisual.css';
interface Props {
	label: string;
}
const { label } = Astro.props;
// Release card of the original visual with three stacked strips for older releases.
// "fix:" imitates a release entry on purpose.
const stack = ['1', '2', '3'];
---

<div class="maintenance-visual" role="img" aria-label={label}>
	<DBCard spacing="medium" className="maintenance-visual-card">
		<h2 class="maintenance-visual-title">Updates from Design System – Components – v4.2.1</h2>
		<p class="maintenance-visual-meta">Published 4 hours ago</p>
		<p class="maintenance-visual-text">fix: button resizing bug</p>
	</DBCard>
	{stack.map((level) => (
		<span class="maintenance-visual-stack" data-level={level} />
	))}
</div>
