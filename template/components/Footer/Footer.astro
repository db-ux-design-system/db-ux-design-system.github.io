---
import { DBFooter, DBFooterMeta, DBLink } from '@db-ux/react-core-components';

interface Props {
	/**
	 * Browsing context for the links. The Theme Builder preview renders the footer inside
	 * an iframe and sets `_top`, so the links open in the main window, not in the frame.
	 */
	linkTarget?: '_top';
}
const { linkTarget } = Astro.props;
const currentPath = Astro.url?.pathname ?? '';
const isDE = currentPath.startsWith('/de/') || currentPath === '/de';
const imprintLabel = isDE ? 'Impressum' : 'Imprint';
const privacyLabel = isDE ? 'Datenschutz' : 'Privacy';
const imprintHref = isDE ? '/de/rechtliches/impressum' : '/legal/imprint';
const privacyHref = isDE ? '/de/rechtliches/datenschutz' : '/legal/privacy';
const contactLabel = isDE ? 'Kontakt' : 'Contact';
// Design system mailbox. The control panel has no contact button, so this is the site-wide contact link.
const contactHref = 'mailto:db-ux-designsystem@deutschebahn.com';
const footerNavLabel = isDE ? 'Kontakt und Rechtliches' : 'Contact and legal';
// DBFooterMeta prepends the copyright sign. No year: the notice is not required
// for protection, and a year would only need maintenance.
const copyright = 'Deutsche Bahn AG';
---

<DBFooter width="full">
	<DBFooterMeta copyright={copyright}>
		<nav aria-label={footerNavLabel}>
			<ul>
				<li>
					<DBLink variant="inline" size="small" href={imprintHref} target={linkTarget}>
						{imprintLabel}
					</DBLink>
				</li>
				<li>
					<DBLink variant="inline" size="small" href={privacyHref} target={linkTarget}>
						{privacyLabel}
					</DBLink>
				</li>
				<li>
					<DBLink variant="inline" size="small" href={contactHref} target={linkTarget}>
						{contactLabel}
					</DBLink>
				</li>
			</ul>
		</nav>
	</DBFooterMeta>
</DBFooter>
