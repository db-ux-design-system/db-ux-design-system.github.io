---
import { DBSection } from '@db-ux/react-core-components';
import PageHero from '@template/components/PageHero/PageHero.astro';

interface Props {
	title?: string;
	headline?: string;
	description?: string;
	startLabel?: string;
}

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

const {
	title = '',
	headline = 'DB Design System designed to align teams and streamline product delivery.',
	description = '',
	startLabel = 'Get started',
} = Astro.props;

// Single entry point into Get Started; the role question there splits into the paths.
// Root-relative for both languages, like the footer links and the language switch.
const actions = [
	{
		label: startLabel,
		href: isDE ? '/de/dokumentation/erste-schritte' : '/documentation/get-started',
	},
];
---

<DBSection width="medium" spacing="medium" id="home--page-hero-section" className="home-page-hero">
	<PageHero
		title={title}
		headline={headline}
		description={description}
		actions={actions}
		headlineLevel={1}
		headlineHighlight="DB Design System"
	/>
</DBSection>
