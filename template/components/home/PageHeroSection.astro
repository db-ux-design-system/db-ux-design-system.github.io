---
import { DBSection } from '@db-ux/react-core-components';
import PageHero from '@template/components/PageHero/PageHero.astro';
import { appConfig } from '@config';

interface Props {
	title?: string;
	headline?: string;
	description?: string;
	designLabel?: string;
	developmentLabel?: string;
}

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

const {
	title = 'DB UX Design System',
	headline = 'A Design System designed to align teams and streamline product delivery.',
	description = 'Brings clarity to design and implementation through shared standards and reusable components.',
	designLabel = 'Start designing',
	developmentLabel = 'Start developing',
} = Astro.props;

// Entry points into Get Started, one per role.
const actions = isDE
	? [
			{ label: designLabel, href: '/de/dokumentation/erste-schritte/design' },
			{ label: developmentLabel, href: '/de/dokumentation/erste-schritte/entwicklung' },
		]
	: [
			{ label: designLabel, href: `${appConfig.basePath}documentation/get-started/design` },
			{
				label: developmentLabel,
				href: `${appConfig.basePath}documentation/get-started/development`,
			},
		];
---

<DBSection width="medium" spacing="medium" id="home--page-hero-section">
	<PageHero
		title={title}
		headlineLevel={1}
		headline={headline}
		description={description}
		actions={actions}
	/>
</DBSection>
