---
import { DBSection, DBStack, DBCard, DBButton, DBTooltip } from '@db-ux/react-core-components';
import './InteractiveDemoSection.css';
import '@template/themes/variables.css';

interface Props {
	darkModeLabel?: string;
	lightModeLabel?: string;
	fullscreenLabel?: string;
	demoTitle?: string;
	themeLabel?: string;
	showB2CLabel?: string;
	showB2BLabel?: string;
}

const {
	darkModeLabel = 'Activate Dark Mode',
	lightModeLabel = 'Activate Light Mode',
	fullscreenLabel = 'Fullscreen',
	demoTitle = 'Interactive demo',
	themeLabel = 'Theme',
	showB2CLabel = 'Show B2C demo',
	showB2BLabel = 'Show B2B demo',
} = Astro.props;
---

<DBSection width="large" spacing="medium" id="home--interactive-demo-section">
	<DBStack>
		<DBCard spacing="none">
			<iframe id="demo-iframe" src="/demo-b2b" title={demoTitle}></iframe>
		</DBCard>
		<DBCard spacing="small" className="actionbar">
			<DBStack direction="row" gap="2x-small">
				<div class="actionbar-group">
					{/* Native select, so the actionbar stays a static island without hydration.
					    home-demo.client.ts listens for its change and reloads the iframe. */}
					<div class="db-select actionbar-theme" data-hide-label="true">
						<label for="demo-theme-select">{themeLabel}</label>
						<select id="demo-theme-select" data-action="theme">
							<option value="default">Deutsche Bahn</option>
							<option value="station">Station</option>
							<option value="s-bahn">S-Bahn</option>
							<option value="neutral">Neutral</option>
						</select>
					</div>
				</div>
				<div class="actionbar-group">
					<DBButton
						aria-label={showB2CLabel}
						data-has-tooltip="true"
						variant="filled"
						noText="true"
						icon="circular_arrows"
						id="toggle-demo"
						data-label-b2c={showB2CLabel}
						data-label-b2b={showB2BLabel}
					>
						<DBTooltip placement="top">{showB2CLabel}</DBTooltip>
					</DBButton>
					<DBButton
						aria-label={darkModeLabel}
						data-has-tooltip="true"
						variant="filled"
						noText="true"
						icon="moon"
						id="toggle-mode"
						data-label-dark={darkModeLabel}
						data-label-light={lightModeLabel}
					>
						<DBTooltip placement="top">{darkModeLabel}</DBTooltip>
					</DBButton>
					<a
						aria-label={fullscreenLabel}
						data-has-tooltip="true"
						class="db-button"
						target="_blank"
						referrerpolicy="no-referrer"
						data-variant="filled"
						data-no-text="true"
						data-icon="fullscreen"
						id="fullscreen-anchor"
					>
						<DBTooltip placement="top">{fullscreenLabel}</DBTooltip>
					</a>
				</div>
			</DBStack>
		</DBCard>
	</DBStack>
</DBSection>
