---
import { DBSection, DBStack, DBCard, DBButton, DBTooltip } from '@db-ux/react-core-components';
import './InteractiveDemoSection.css';
import '@template/themes/variables.css';

interface Props {
	darkModeLabel?: string;
	lightModeLabel?: string;
	fullscreenLabel?: string;
	demoTitle?: string;
}

const {
	darkModeLabel = 'Activate Dark Mode',
	lightModeLabel = 'Activate Light Mode',
	fullscreenLabel = 'Fullscreen',
	demoTitle = 'Interactive demo',
} = Astro.props;
---

<DBSection width="medium" spacing="medium" id="home--interactive-demo-section">
	<DBStack>
		<DBCard spacing="small" className="actionbar">
			<DBStack direction="row" gap="2x-small">
				<div class="actionbar-group">
					<DBButton variant="filled" icon="circular_arrows" id="toggle-demo">B2C</DBButton>
				</div>
				<div class="actionbar-group">
					<DBButton variant="brand" data-action="theme" data-value="default">
						<span class="label-full">Deutsche Bahn</span><span class="label-short">DB</span>
					</DBButton>
					<DBButton data-theme="station" variant="brand" data-action="theme" data-value="station"
						>Station</DBButton
					>
					<DBButton data-theme="s-bahn" variant="brand" data-action="theme" data-value="s-bahn"
						>S-Bahn</DBButton
					>
					<DBButton data-theme="neutral" variant="brand" data-action="theme" data-value="neutral"
						>Neutral</DBButton
					>
				</div>
				<div class="actionbar-group">
					<DBButton
						title={darkModeLabel}
						variant="filled"
						noText="true"
						icon="moon"
						id="toggle-mode"
						data-label-dark={darkModeLabel}
						data-label-light={lightModeLabel}
					>
						<DBTooltip>{darkModeLabel}</DBTooltip>
					</DBButton>
					<a
						title={fullscreenLabel}
						class="db-button"
						target="_blank"
						referrerpolicy="no-referrer"
						data-variant="filled"
						data-no-text="true"
						data-icon="fullscreen"
						id="fullscreen-anchor">{fullscreenLabel}</a
					>
				</div>
			</DBStack>
		</DBCard>
		<DBCard spacing="none">
			<iframe id="demo-iframe" src="/demo-b2b" title={demoTitle}></iframe>
		</DBCard>
	</DBStack>
</DBSection>
