---
import { appConfig } from '@config';
import { DBCard, DBSection, DBStack } from '@db-ux/react-core-components';
import { SectionTitle, TextImage, DisabledWrapper } from '@components';
import { toDeSlug } from '@template/i18n/slug-mapping';

interface Props {
	sectionTitle?: string;
	sectionDescription?: string;
	foundationTitle?: string;
	foundationText?: string;
	componentsTitle?: string;
	componentsText?: string;
	extensionsTitle?: string;
	extensionsText?: string;
	patternsTitle?: string;
	patternsText?: string;
	templatesTitle?: string;
	templatesText?: string;
	comingSoonLabel?: string;
	linkPrefix?: string;
}

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const localizeHref = (enPath: string) => isDE ? `/de/${toDeSlug(enPath)}` : `${appConfig.basePath}${enPath}`;

const {
	sectionTitle = 'A unified model for product teams',
	sectionDescription = 'Shared fundamentals, components and domain-specific extensions that support clarity and alignment.',
	foundationTitle = 'Foundation',
	foundationText = 'Shared base tokens and modes provide a stable foundation for clear and coherent interfaces.',
	componentsTitle = 'Components',
	componentsText = 'Core components ensure predictable interactions across products.',
	extensionsTitle = 'Extensions',
	extensionsText = 'Contextual standards that build on the core system to support domain-specific needs.',
	patternsTitle = 'Patterns',
	patternsText = 'Reusable interaction models that guide consistent behavior across products.',
	templatesTitle = 'Templates',
	templatesText = 'Structured starting points that speed up page creation and enforce coherent layouts.',
	comingSoonLabel = 'Coming Soon',
	linkPrefix = '',
} = Astro.props;

// Link labels mirror the destination page title, so screen reader users hear
// the same name they land on. Localised here because the labels are not props.
const openPageLabel = (title: string) => (isDE ? `Seite ${title} öffnen` : `Open ${title} page`);
---

<DBSection
	width="medium"
	spacing="medium"
	aria-label={sectionTitle}
	id="home--unified-model-section"
>
	<SectionTitle
		title={sectionTitle}
		description={sectionDescription}
	/>
	<DBStack gap="large">
		<a
			href={localizeHref("products-and-services/foundations")}
			aria-label={openPageLabel(foundationTitle)}
		>
			<DBCard behavior="interactive" spacing="large">
				<TextImage
					title={foundationTitle}
					imagePosition="right"
					imageWidth="33"
					imageSrc={`${appConfig.basePath}assets/Foundations-Teaser--C.png`}
					imageAlt=""
					mask="fade-bottom-right"
				>
					{foundationText}
				</TextImage>
			</DBCard>
		</a>
		<a
			href={localizeHref("products-and-services/components")}
			aria-label={openPageLabel(componentsTitle)}
		>
			<DBCard behavior="interactive" spacing="large">
				<TextImage
					title={componentsTitle}
					imagePosition="right"
					imageWidth="33"
					imageSrc={`${appConfig.basePath}assets/Components-Teaser--C.png`}
					imageAlt=""
					mask="fade-bottom-right"
				>
					{componentsText}
				</TextImage>
			</DBCard>
		</a>
		<a
			href={localizeHref("products-and-services/extensions")}
			aria-label={openPageLabel(extensionsTitle)}
		>
			<DBCard behavior="interactive" spacing="large">
				<TextImage
					imagePosition="right"
					imageWidth="33"
					title={extensionsTitle}
					imageSrc={`${appConfig.basePath}assets/Extensions-Teaser--C.png`}
					imageAlt=""
					mask="fade-bottom-right"
				>
					{extensionsText}
				</TextImage>
			</DBCard>
		</a>
		<DBStack direction="row">
			<DisabledWrapper
				label={comingSoonLabel}
				ariaLabel={`${patternsTitle} – ${comingSoonLabel}`}
				size="medium"
			>
				<DBCard spacing="large">
					<TextImage
						imagePosition="right"
						imageWidth="33"
						title={patternsTitle}
						imageSrc={`${appConfig.basePath}assets/Patterns-Teaser--C.png`}
						imageAlt=""
						mask="fade-bottom-right"
					>
						{patternsText}
					</TextImage>
				</DBCard>
			</DisabledWrapper>
			<DisabledWrapper
				label={comingSoonLabel}
				ariaLabel={`${templatesTitle} – ${comingSoonLabel}`}
				size="medium"
			>
				<DBCard spacing="large">
					<TextImage
						imagePosition="right"
						imageWidth="33"
						title={templatesTitle}
						imageSrc={`${appConfig.basePath}assets/Templates-Teaser--C.png`}
						imageAlt=""
						mask="fade-bottom-right"
					>
						{templatesText}
					</TextImage>
				</DBCard>
			</DisabledWrapper>
		</DBStack>
	</DBStack>
</DBSection>
