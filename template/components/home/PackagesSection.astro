---
import { appConfig } from '@config';
import { DBSection, DBStack } from '@db-ux/react-core-components';
import { SectionTitle } from '@components';
import TeaserCard from '@template/components/TeaserCard/TeaserCard.astro';
import { toDeSlug } from '@template/i18n/slug-mapping';

interface Props {
	sectionTitle?: string;
	sectionDescription?: string;
	foundationTitle?: string;
	foundationText?: string;
	componentsTitle?: string;
	componentsText?: string;
	extensionsTitle?: string;
	extensionsText?: string;
	patternsTitle?: string;
	patternsText?: string;
	templatesTitle?: string;
	templatesText?: string;
	comingSoonLabel?: string;
	linkPrefix?: string;
}

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const localizeHref = (enPath: string) =>
	isDE ? `/de/${toDeSlug(enPath)}` : `${appConfig.basePath}${enPath}`;

const {
	sectionTitle = 'A Design System for everyone',
	sectionDescription = 'The Design System empowers all DB teams to build their products consistently, efficiently, and with a user-centered focus.',
	foundationTitle = 'Foundation',
	foundationText = 'Design foundations provide the basis for a consistent user experience.',
	componentsTitle = 'Components',
	componentsText = 'Reusable components provide the structure for consistent user interfaces.',
	extensionsTitle = 'Extensions',
	extensionsText = 'Product-specific components extend the Design System to support specific use cases.',
	patternsTitle = 'Patterns',
	patternsText = 'Reusable interaction models that guide consistent behavior across products.',
	templatesTitle = 'Templates',
	templatesText = 'Structured starting points that speed up page creation and enforce coherent layouts.',
	comingSoonLabel = 'Coming Soon',
	linkPrefix = '',
} = Astro.props;

// Link labels mirror the destination page title, so screen reader users hear
// the same name they land on. Localised here because the labels are not props.
const openPageLabel = (title: string) => (isDE ? `Seite ${title} öffnen` : `Open ${title} page`);

// The three available packages, each full width (columns 1). Patterns and Templates follow
// below as a two-column block, because they are not available yet.
const availableTeasers = [
	{
		title: foundationTitle,
		description: foundationText,
		url: localizeHref('products-and-services/foundations'),
		visual: 'foundation' as const,
		imagePosition: 'right' as const,
		imageWidth: '25' as const,
		ariaLabel: openPageLabel(foundationTitle),
	},
	{
		title: componentsTitle,
		description: componentsText,
		url: localizeHref('products-and-services/components'),
		visual: 'components' as const,
		imagePosition: 'right' as const,
		imageWidth: '25' as const,
		ariaLabel: openPageLabel(componentsTitle),
	},
	{
		title: extensionsTitle,
		description: extensionsText,
		url: localizeHref('products-and-services/extensions'),
		visual: 'extensions' as const,
		imagePosition: 'right' as const,
		imageWidth: '25' as const,
		ariaLabel: openPageLabel(extensionsTitle),
	},
];

const comingSoonTeasers = [
	{
		title: patternsTitle,
		description: patternsText,
		visual: 'patterns' as const,
		imagePosition: 'right' as const,
		imageWidth: '33' as const,
		disabled: true,
		ariaLabel: `${patternsTitle} – ${comingSoonLabel}`,
	},
	{
		title: templatesTitle,
		description: templatesText,
		visual: 'templates' as const,
		imagePosition: 'right' as const,
		imageWidth: '33' as const,
		disabled: true,
		ariaLabel: `${templatesTitle} – ${comingSoonLabel}`,
	},
];
---

<DBSection
	width="medium"
	spacing="medium"
	aria-label={sectionTitle}
	id="home--unified-model-section"
>
	<SectionTitle title={sectionTitle} description={sectionDescription} />
	<DBStack gap="large">
		<TeaserCard teasers={availableTeasers} columns={1} spacing="large" headlineLevel={3} />
		<TeaserCard teasers={comingSoonTeasers} columns={2} spacing="large" headlineLevel={3} />
	</DBStack>
</DBSection>
