---
import { appConfig } from '@config';
import { DBCard, DBSection } from '@db-ux/react-core-components';
import { SectionTitle, TextImage } from '@components';
import { toDeSlug } from '@template/i18n/slug-mapping';
import EfficientDeliveryVisual from '@components/ForProductManagementVisuals/EfficientDeliveryVisual.astro';
import ReleaseTimelineVisual from '@components/ForDeveloperVisuals/ReleaseTimelineVisual.astro';
import ButtonPlaygroundVisual from '@components/ForDesignerVisuals/ButtonPlaygroundVisual.astro';
import './DesignedForSection.css';

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
const localizeHref = (enPath: string) =>
	isDE ? `/de/${toDeSlug(enPath)}` : `${appConfig.basePath}${enPath}`;

interface Props {
	sectionTitle?: string;
	sectionDescription?: string;
	pmTitle?: string;
	pmText?: string;
	pmTag?: string;
	devTitle?: string;
	devText?: string;
	devTag?: string;
	designTitle?: string;
	designText?: string;
	designTag?: string;
	pmVisualLabel?: string;
	devVisualLabel?: string;
	designVisualLabel?: string;
	linkPrefix?: string;
}

const {
	sectionTitle = 'How the system supports your work',
	sectionDescription = 'The Design System helps you build digital products more easily, predictably, and efficiently.',
	pmTitle = 'Decide with confidence',
	pmText = 'Shared standards reduce rework and eliminate recurring discussions.',
	pmTag = 'For Product Management',
	devTitle = 'Develop with ease',
	devText = 'Updates and changes can be planned early and implemented efficiently.',
	devTag = 'For Developer',
	designTitle = 'Design with flexibility',
	designText = 'Products can be adapted to different requirements while maintaining consistency.',
	designTag = 'For Designer',
	// Labels of the static code visuals, same wording as on the audience pages
	pmVisualLabel = 'Timeline compression illustrating faster delivery cycles',
	devVisualLabel = 'Version timeline and update badges denoting planned maintenance',
	designVisualLabel = 'Button playground with variant, text, show icon and icon settings',
	linkPrefix = '',
} = Astro.props;

// The tag props ("For Developer" / "Für Entwickler:innen") match the destination
// page titles, so the link label names the page the user lands on. In German the
// preposition belongs inside the sentence, so it is stripped from the tag.
const audiencePageLabel = (tag: string) =>
	isDE ? `Seite für ${tag.replace(/^Für\s+/i, '')} öffnen` : `Open ${tag} page`;
---

<DBSection
	width="medium"
	spacing="medium"
	aria-label={sectionTitle}
	id="home--designed-for-section"
>
	<SectionTitle title={sectionTitle} description={sectionDescription} />
	<div class="cards-row-fixed">
		<a
			href={localizeHref('products-and-services/for-productmanagement')}
			aria-label={audiencePageLabel(pmTag)}
		>
			<DBCard behavior="interactive" data-color="violet" spacing="large">
				<TextImage
					imagePosition="top"
					contentAlign="end"
					imageWidth="33"
					title={pmTitle}
					imageSrc=""
					imageAlt=""
					headlineLevel={3}
					tag={{ label: pmTag, emphasis: 'strong' }}
				>
					<div slot="visual" class="designed-for-visual" data-color="neutral">
						<div class="designed-for-visual-canvas">
							<EfficientDeliveryVisual label={pmVisualLabel} static />
						</div>
					</div>
					{pmText}
				</TextImage>
			</DBCard>
		</a>
		<a
			href={localizeHref('products-and-services/for-developer')}
			aria-label={audiencePageLabel(devTag)}
		>
			<DBCard behavior="interactive" data-color="green" spacing="large">
				<TextImage
					imagePosition="top"
					contentAlign="end"
					imageWidth="33"
					title={devTitle}
					imageSrc=""
					imageAlt=""
					headlineLevel={3}
					tag={{ label: devTag, emphasis: 'strong' }}
				>
					<div slot="visual" class="designed-for-visual" data-color="neutral">
						<div class="designed-for-visual-canvas">
							<ReleaseTimelineVisual label={devVisualLabel} />
						</div>
					</div>
					{devText}
				</TextImage>
			</DBCard>
		</a>

		<a
			href={localizeHref('products-and-services/for-designer')}
			aria-label={audiencePageLabel(designTag)}
		>
			<DBCard behavior="interactive" data-color="blue" spacing="large">
				<TextImage
					imagePosition="top"
					contentAlign="end"
					imageWidth="33"
					title={designTitle}
					imageSrc=""
					imageAlt=""
					headlineLevel={3}
					tag={{ label: designTag, emphasis: 'strong' }}
				>
					<div slot="visual" class="designed-for-visual" data-color="neutral">
						<div class="designed-for-visual-canvas">
							<ButtonPlaygroundVisual label={designVisualLabel} static />
						</div>
					</div>
					{designText}
				</TextImage>
			</DBCard>
		</a>
	</div>
</DBSection>
