---
import { DBIcon } from '@db-ux/react-core-components';
import './ConsistentResultsVisual.css';

interface Props {
	label: string;
}

const { label } = Astro.props;

// The same page wireframe on two devices: a phone (portrait) and a desktop (landscape).
// Both share one markup; the CSS adapts the navigation and the CTA to each format.
// All blocks are spans, so the global div + div content spacing does not apply.
const devices = ['phone', 'desktop'] as const;
const navItems = 5;
const textLines = 3;
const fields = 4;
---

<div class="consistent-results-visual" role="img" aria-label={label}>
	{devices.map((device, index) => (
		<>
			{index > 0 && (
				<span class="consistent-results-visual-connector">
					<span class="consistent-results-visual-line" />
					<DBIcon icon="circular_arrows" className="consistent-results-visual-icon" />
					<span class="consistent-results-visual-line" />
				</span>
			)}
			<span class="consistent-results-visual-device" data-device={device}>
				{device === 'phone' && <span class="consistent-results-visual-notch" />}
				<span class="consistent-results-visual-screen">
					<span class="consistent-results-visual-nav">
						{Array.from({ length: navItems }, (_, i) => (
							<span
								class="consistent-results-visual-nav-item"
								data-active={i === 0 ? 'true' : undefined}
							/>
						))}
					</span>
					<span class="consistent-results-visual-main">
						<span class="consistent-results-visual-hero" />
						<span class="consistent-results-visual-group">
							<span class="consistent-results-visual-title" />
							{Array.from({ length: textLines }, (_, i) => (
								<span class="consistent-results-visual-text" data-line={i + 1} />
							))}
						</span>
						<span class="consistent-results-visual-group">
							{Array.from({ length: fields }, () => (
								<span class="consistent-results-visual-field" />
							))}
						</span>
						<span class="consistent-results-visual-cta" />
					</span>
				</span>
			</span>
		</>
	))}
</div>
