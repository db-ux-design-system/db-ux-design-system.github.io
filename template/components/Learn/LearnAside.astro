---
import { learnViewTexts } from './learn-view-texts';

// Derive the language from the URL, like the layouts do.
const lang = Astro.url.pathname.startsWith('/de/') ? 'de' : 'en';
const t = learnViewTexts[lang];
---

{/*
	Additional information that belongs to the step it sits in. Place it inside a
	LearnBlock, after the main content.

	Article view: the content is shown, the button is hidden – it reads as normal
	content.
	Stepper view: the controller hides the content and shows a "Show more" ghost button;
	clicking it reveals the content above the button, which then reads "Show less".

	The content comes before the button in the DOM, so when it expands it appears above
	the button. Without JS the content stays visible (the button is hidden by default),
	so the article fallback shows everything.
*/}
<div class="learn-aside" data-learn-aside>
	<div class="learn-aside-body" data-learn-aside-body>
		<slot />
	</div>
	<button
		type="button"
		class="db-button learn-aside-toggle"
		data-variant="ghost"
		data-icon="plus"
		data-learn-aside-toggle
		data-label-more={t.moreInfo}
		data-label-less={t.lessInfo}
		aria-expanded="false"
		hidden
	>
		{t.moreInfo}
	</button>
</div>
