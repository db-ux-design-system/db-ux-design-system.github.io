---
import { DBSection } from '@db-ux/react-core-components';

interface Props {
	/** Block heading, rendered as an h2. Also used as the step label in the stepper. */
	title: string;
}

const { title } = Astro.props as Props;
---

{/*
	A main Learn block. One block equals one step in the stepper view. The heading and
	body render as a normal section in article view; the LearnArticle controller shows
	exactly one block at a time in stepper view. The data-learn-title is read by the
	controller to label the step without parsing the heading.
*/}
<DBSection spacing="small" width="full">
	<div class="learn-block" data-learn-block data-learn-title={title}>
		<h2 class="learn-block-title" tabindex="-1">{title}</h2>
		<slot />
	</div>
</DBSection>
