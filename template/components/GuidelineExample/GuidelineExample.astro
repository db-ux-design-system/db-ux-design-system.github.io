---
import { DBBadge, DBCard } from '@db-ux/react-core-components';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';
import './GuidelineExample.css';

interface Props {
	variant?: 'do' | 'dont' | 'caution';
	/** Omit for guidelines that have no visual yet – the card then renders text only. */
	figmaUrl?: string;
	description?: string;
	fullWidth?: boolean;
	halfWidth?: boolean;
	layout?: 'default' | 'side';
	imageRatio?: 'landscape' | 'portrait' | 'square';
}

const {
	variant,
	figmaUrl,
	description,
	fullWidth = false,
	halfWidth = false,
	layout = 'default',
	imageRatio = 'landscape',
} = Astro.props;
const isHalfWidth = halfWidth && !fullWidth && layout === 'default';
const semantic =
	variant === 'do'
		? 'successful'
		: variant === 'caution'
			? 'warning'
			: variant === 'dont'
				? 'critical'
				: undefined;
const label =
	variant === 'do'
		? 'Do'
		: variant === 'caution'
			? 'Caution'
			: variant === 'dont'
				? "Don't"
				: undefined;
const fullUrl = figmaUrl
	? `${figmaUrl}&embed-host=share&footer=false&viewport-controls=false&page-selector=false&scaling=scale-down-width`
	: undefined;

// Resolve cached image from manifest
const manifestPath = resolve('static/assets/figma-cache/manifest.json');
let cachedImageSrc: string | undefined;
if (figmaUrl && existsSync(manifestPath)) {
	const manifest = JSON.parse(readFileSync(manifestPath, 'utf-8'));
	// Normalize lookup key: strip extra embed params, keep node-id only
	const base = figmaUrl.split('?')[0];
	const nodeIdMatch = figmaUrl.match(/[?&]node-id=([^&]+)/);
	const lookupKey = nodeIdMatch ? `${base}?node-id=${nodeIdMatch[1]}&embed-host=share` : figmaUrl;
	cachedImageSrc = manifest[lookupKey];
}

const hasSlot = Astro.slots.has('default');
// Without a visual the description carries the card itself, so no figcaption is rendered.
const hasVisual = Boolean(cachedImageSrc ?? fullUrl);
const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';
// The figcaption describes what the image shows, so the image itself is decorative
// and gets an empty alt. An iframe still needs an accessible name.
const frameTitle = description ?? (isDE ? 'Figma-Beispiel' : 'Figma example');
---

<figure
	class="guideline-example-container"
	data-full-width={fullWidth}
	data-half-width={isHalfWidth}
	data-layout={layout}
	data-image-ratio={imageRatio}
>
	<DBCard elevationLevel="2" data-mode="light">
		{
			variant && (
				<div class="guideline-example-badge">
					<DBBadge semantic={semantic} emphasis="strong" size="medium">
						<span>{label}</span>
					</DBBadge>
				</div>
			)
		}
		{
			cachedImageSrc ? (
				<img class="guideline-example-iframe" src={cachedImageSrc} alt="" loading="lazy" />
			) : fullUrl ? (
				<iframe
					class="guideline-example-iframe"
					src={fullUrl}
					title={frameTitle}
					loading="eager"
					allowfullscreen
				/>
			) : (
				description && <p class="guideline-example-text">{description}</p>
			)
		}
	</DBCard>
	{
		layout === 'side' && hasSlot ? (
			<figcaption class="guideline-example-side-content">
				<slot />
			</figcaption>
		) : description && hasVisual ? (
			<figcaption>{description}</figcaption>
		) : null
	}
</figure>
