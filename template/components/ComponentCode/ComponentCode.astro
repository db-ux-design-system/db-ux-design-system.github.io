---
/*
 * Development section of a component page (pilot, see PR #832).
 *
 * A short entry for developers. The technical documentation (installation,
 * usage per framework, all examples with code, properties, migration) lives
 * in Storybook, versioned per release; the platform shows the current version
 * only and links there.
 *
 * - Getting started: links to the framework setup pages
 * - Storybook: one card to the component's entry page in the composition
 *   Storybook, where the framework is chosen
 *
 * The section headings are h3, so they nest under the page's `## Development` (DE: `## Entwicklung`).
 * Storybook is English only; DE pages say so.
 */
import ResourceCards from '@template/components/ResourceCards/ResourceCards.astro';
import pkg from '../../../package.json';
import './ComponentCode.css';

interface Props {
	/**
	 * Fallback: Storybook docs page of the released version, without the
	 * `--docs` suffix, e.g. `components-dbbutton-variant`. Used while
	 * `storybookOverview` is not set.
	 */
	storybookExample: string;
	/**
	 * PROTOTYPE – entry page of the component in the composition Storybook
	 * (core-web#8649), without `--docs`, e.g. `components-dbbutton`. Once it is
	 * released, the card links to it in the versioned Storybook and
	 * `storybookExample` goes away.
	 */
	storybookOverview?: string;
	/** PROTOTYPE – Storybook deployment that contains the entry page. */
	storybookOverviewBaseUrl?: string;
}

const { storybookExample, storybookOverview, storybookOverviewBaseUrl } = Astro.props;

const isDE = Astro.url.pathname.startsWith('/de/') || Astro.url.pathname === '/de';

/** The components on the platform are rendered with this exact version. */
const version = pkg.devDependencies['@db-ux/core-components'];
const versionBaseUrl = `https://design-system.deutschebahn.com/core-web/version/v${version}`;

/*
 * One card for all frameworks: it opens the component's entry page in the
 * composition Storybook, which leads to the overview of each framework
 * Storybook. Until the entry pages are released, the fallback links to the
 * composition Storybook of the pinned version.
 */
const storybookUrl =
	storybookOverview && storybookOverviewBaseUrl
		? `${storybookOverviewBaseUrl}/composition-storybook/?path=/docs/${storybookOverview}--docs`
		: `${versionBaseUrl}/composition-storybook/?path=/docs/react_${storybookExample}--docs`;

const storybookResources = [
	{
		title: 'Storybook',
		description: isDE
			? 'React, Angular, Vue, Web Components und HTML: Installation, Beispiele mit Code, Properties und Migration.'
			: 'React, Angular, Vue, Web Components and HTML: installation, examples with code, properties and migration.',
		url: storybookUrl,
	},
];

const setupLinks = [
	{ label: 'React', en: 'react-setup', de: 'react-einrichten' },
	{ label: 'Angular', en: 'angular-setup', de: 'angular-einrichten' },
	{ label: 'Vue', en: 'vue-setup', de: 'vue-einrichten' },
	{ label: 'Web Components', en: 'web-components-setup', de: 'web-components-einrichten' },
	{ label: 'HTML/CSS', en: 'html-css-setup', de: 'html-css-einrichten' },
].map(({ label, en, de }) => ({
	label,
	url: isDE ? `/de/dokumentation/lernen/${de}` : `/documentation/learn/${en}`,
}));

const t = isDE
	? {
			gettingStarted: 'Einstieg',
			gettingStartedText:
				'Installation und Konfiguration der Pakete findest du auf den Setup-Seiten:',
			storybook: 'Storybook',
			storybookText:
				'Die vollständige technische Dokumentation findest du im Storybook. Dort wählst du dein Framework und die Version. Storybook ist nur auf Englisch verfügbar.',
			version: `Diese Seite zeigt @db-ux/core-components ${version}.`,
		}
	: {
			gettingStarted: 'Getting started',
			gettingStartedText:
				'For installation and configuration of the packages, see the setup pages:',
			storybook: 'Storybook',
			storybookText:
				'The complete technical documentation is in Storybook, where you choose your framework and version.',
			version: `This page shows @db-ux/core-components ${version}.`,
		};
---

<div class="component-code">
	<h3>{t.gettingStarted}</h3>
	<p>{t.gettingStartedText}</p>
	<ul class="component-code-setup-links">
		{setupLinks.map(({ label, url }) => (
			<li>
				<a href={url}>{label}</a>
			</li>
		))}
	</ul>

	<h3>{t.storybook}</h3>
	<p>{t.storybookText}</p>
	<ResourceCards resources={storybookResources} />
	<p class="component-code-version">{t.version}</p>
</div>
