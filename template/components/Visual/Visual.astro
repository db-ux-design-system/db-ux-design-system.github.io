---
import {
	getVisualNames,
	isVisualName,
	nextVisualPrefix,
	parseVisualSvg,
	prefixSvgIds,
	resolveVisualColor,
	resolveVisualSize,
	resolveVisualStrokeWidth,
	VISUAL_STROKE_SCALING,
	type VisualColor,
	type VisualName,
	type VisualSize,
	type VisualStrokeScaling,
	type VisualStrokeWidth,
} from './visual-svg';
import {
	getVisualImageNames,
	isVisualImageName,
	resolveVisualImageSrc,
	type VisualImageName,
} from './visual-image';
import './Visual.css';
/**
 * Visual – Renders a visual from the internal library. Two sources are supported:
 *
 * - `name`: an SVG from `template/visuals/`, inlined so colors and stroke width follow DB UX
 *   tokens and Light/Dark Mode
 * - `image`: a PNG from `static/assets/teasers/`, rendered as `<img>`
 *
 * A PNG is a raster image: it has no tokens, no stroke and no Light/Dark switching, so it has to
 * work in both color modes as it is. Only `size`/`width`/`height`, `surface`, `label` and `class`
 * apply – the stroke and color props throw. See `template/visuals/README.md`.
 *
 * ## Component Props
 *
 * | Prop            | Type                | Default        | Description                                                  |
 * |-----------------|---------------------|----------------|--------------------------------------------------------------|
 * | `name`          | `VisualName`        | –              | File name in `template/visuals/` without `.svg`. Required unless `image` is set |
 * | `image`         | `VisualImageName`   | –              | File name in `static/assets/teasers/` without `.png`. Mutually exclusive with `name` |
 * | `stroke`        | `VisualColor`       | `currentColor` | SVG only. Primary stroke color (`--visual-stroke`)           |
 * | `accent`        | `VisualColor`       | `stroke`       | SVG only. Accent stroke/detail color (`--visual-accent`)     |
 * | `fill`          | `VisualColor`       | `none`         | SVG only. Surface fill (`--visual-fill`)                     |
 * | `strokeWidth`   | `VisualStrokeWidth` | `2` / ratio    | SVG only. Stroke width (`--visual-stroke-width`): px with `fixed`, viewBox units with `scale`. Default with `scale`: `--visual-stroke-ratio` × viewBox width |
 * | `size`          | `VisualSize`        | `100%`         | Inline size (alias for `width`)                              |
 * | `width`         | `VisualSize`        | `100%`         | Inline size (`--visual-inline-size`)                         |
 * | `height`        | `VisualSize`        | `auto`         | Block size (`--visual-block-size`)                           |
 * | `label`         | `string`            | –              | Accessible name. Without it the visual is decorative         |
 * | `strokeScaling` | `VisualStrokeScaling` | `fixed`      | SVG only. `fixed`: constant stroke in px, `scale`: stroke grows with the visual |
 * | `surface`       | `boolean`           | `false`        | Square light grey surface behind the visual. `size`/`width`/`height`, `class` and `--visual-inline-size` then size the surface, the visual takes `--visual-surface-content-size` of it. Inside `TextImage` the image column sizes the surface instead |
 * | `class`         | `string`            | –              | Additional CSS classes (on the surface when `surface` is set) |
 */
interface Props {
	/** File name in `template/visuals/` without `.svg`. Required unless `image` is set. */
	name?: VisualName;
	/**
	 * File name in `static/assets/teasers/` without `.png`. Renders the PNG as `<img>`.
	 * Mutually exclusive with `name`.
	 */
	image?: VisualImageName;
	/** SVG only. Primary stroke color. Defaults to `currentColor`. */
	stroke?: VisualColor;
	/** SVG only. Accent color for secondary strokes and details. Defaults to `stroke`. */
	accent?: VisualColor;
	/** SVG only. Fill color for surfaces. Defaults to `none`. */
	fill?: VisualColor;
	/**
	 * SVG only. Stroke width. Interpreted as screen px with `strokeScaling="fixed"` (default `2`)
	 * and as viewBox units with `strokeScaling="scale"` (default `--visual-stroke-ratio` × viewBox width).
	 */
	strokeWidth?: VisualStrokeWidth;
	/** Inline size, alias for `width`. */
	size?: VisualSize;
	/** Inline size. Defaults to `100%` of the container. */
	width?: VisualSize;
	/** Block size. Defaults to `auto` (aspect ratio of the source). */
	height?: VisualSize;
	/** Accessible name. Makes the visual informative (`role="img"` / `alt`). */
	label?: string;
	/**
	 * SVG only. `fixed` (default): constant stroke width at every size
	 * (`vector-effect: non-scaling-stroke`). `scale`: the stroke width scales with the rendered size.
	 */
	strokeScaling?: VisualStrokeScaling;
	/**
	 * Renders a square surface (`--visual-surface-bg`) behind the visual and centers the visual in it.
	 * `size`/`width`/`height`, `class` and `--visual-inline-size` then apply to the surface; the visual
	 * takes `--visual-surface-content-size` of it. Inside `TextImage` (slot `visual`) the image column
	 * sizes the surface and the size props have no effect.
	 */
	surface?: boolean;
	/** Additional CSS classes. */
	class?: string;
}
const {
	name,
	image,
	stroke,
	accent,
	fill,
	strokeWidth,
	size,
	width,
	height,
	label,
	strokeScaling,
	surface = false,
	class: className,
} = Astro.props;

if (name !== undefined && image !== undefined) {
	throw new Error(
		`[Visual] Set either "name" (SVG from template/visuals/) or "image" (PNG from ` +
			`static/assets/teasers/), not both. Got name="${name}" and image="${image}".`,
	);
}
if (name === undefined && image === undefined) {
	throw new Error(
		'[Visual] Set "name" for an SVG from template/visuals/ or "image" for a PNG from ' +
			'static/assets/teasers/.',
	);
}

const isImage = image !== undefined;

// A PNG carries its own colors and has no stroke, so the SVG-only props can't be honored.
// They throw instead of being dropped silently, which would look like a styling bug on the page.
if (image !== undefined) {
	if (!isVisualImageName(image)) {
		throw new Error(
			`[Visual] Unknown image "${image}". Available: ${getVisualImageNames().join(', ')}`,
		);
	}
	const svgOnly = (
		[
			['stroke', stroke],
			['accent', accent],
			['fill', fill],
			['strokeWidth', strokeWidth],
			['strokeScaling', strokeScaling],
		] as const
	)
		.filter(([, value]) => value !== undefined)
		.map(([property]) => property);
	if (svgOnly.length > 0) {
		throw new Error(
			`[Visual] ${svgOnly.join(', ')} ${svgOnly.length === 1 ? 'is' : 'are'} only supported for ` +
				`SVG visuals, but image="${image}" is a PNG. A raster visual has no tokens and no ` +
				'stroke – remove the prop, or add the visual as an SVG in template/visuals/.',
		);
	}
}

const scaling = strokeScaling ?? 'fixed';

// `undefined` only for a raster visual – the case that neither prop is set already threw above
const svgName = image === undefined ? name : undefined;

if (svgName !== undefined && !isVisualName(svgName)) {
	throw new Error(
		`[Visual] Unknown visual "${svgName}". Available: ${getVisualNames().join(', ')}`,
	);
}

if (!(VISUAL_STROKE_SCALING as readonly string[]).includes(scaling)) {
	throw new Error(
		`[Visual] Invalid strokeScaling "${scaling}". Use ${VISUAL_STROKE_SCALING.join(' or ')}.`,
	);
}

// SVG source: parsed and ID-prefixed per instance. Skipped for a raster visual.
const svg = svgName === undefined ? undefined : parseVisualSvg(svgName);
const prefix = svgName === undefined ? undefined : nextVisualPrefix(svgName);
const markup = svg && prefix ? prefixSvgIds(svg.inner, prefix) : '';
const titleId = prefix ? `${prefix}-title` : undefined;
const imageSrc = image === undefined ? undefined : resolveVisualImageSrc(image);

const inlineSize = size ?? width;
// viewBox width, used for the proportional default stroke width with `strokeScaling="scale"`
const viewBoxSize = svg
	? Number.parseFloat(svg.attributes.viewBox.trim().split(/[\s,]+/)[2] ?? '')
	: Number.NaN;
type Variables = [string, string | undefined][];
const toStyle = (variables: Variables) =>
	variables
		.filter(([, value]) => value !== undefined)
		.map(([property, value]) => `${property}: ${value}`)
		.join('; ') || undefined;

// Colors, stroke and viewBox always sit on the <svg>; a raster visual has none of them
const svgVariables: Variables = isImage
	? []
	: [
			['--visual-viewbox-size', Number.isFinite(viewBoxSize) ? String(viewBoxSize) : undefined],
			['--visual-stroke', stroke && resolveVisualColor(stroke)],
			['--visual-accent', accent && resolveVisualColor(accent)],
			['--visual-fill', fill && resolveVisualColor(fill)],
			[
				'--visual-stroke-width',
				strokeWidth === undefined ? undefined : resolveVisualStrokeWidth(strokeWidth),
			],
		];
// Size: on the visual, or on the surface when `surface` is set (the visual then takes
// `--visual-surface-content-size` of the surface)
const sizeVariables: Variables = [
	[
		'--visual-inline-size',
		inlineSize ? resolveVisualSize(inlineSize) : height ? 'auto' : undefined,
	],
	['--visual-block-size', height && resolveVisualSize(height)],
];
const visualStyle = toStyle(surface ? svgVariables : [...svgVariables, ...sizeVariables]);
const surfaceStyle = surface ? toStyle(sizeVariables) : undefined;

const a11yAttributes = label
	? ({ role: 'img', 'aria-labelledby': titleId } as const)
	: ({ 'aria-hidden': 'true' } as const);
// The class list of the visual itself. With `surface` the extra classes sit on the surface.
const visualClass = ['db-visual', { 'db-visual-stroke-scale': !isImage && scaling === 'scale' }];
---

{surface ? (
	<span class:list={['db-visual-surface', className]} style={surfaceStyle}>
		{isImage ? (
			<img
				class:list={[...visualClass, 'db-visual-image']}
				style={visualStyle}
				src={imageSrc}
				alt={label ?? ''}
				data-visual={image}
				loading="lazy"
				decoding="async"
			/>
		) : (
			<svg
				{...svg?.attributes}
				class:list={visualClass}
				style={visualStyle}
				data-visual={name}
				focusable="false"
				{...a11yAttributes}
			>
				{label && <title id={titleId}>{label}</title>}
				<Fragment set:html={markup} />
			</svg>
		)}
	</span>
) : isImage ? (
	<img
		class:list={[...visualClass, 'db-visual-image', className]}
		style={visualStyle}
		src={imageSrc}
		alt={label ?? ''}
		data-visual={image}
		loading="lazy"
		decoding="async"
	/>
) : (
	<svg
		{...svg?.attributes}
		class:list={[...visualClass, className]}
		style={visualStyle}
		data-visual={name}
		focusable="false"
		{...a11yAttributes}
	>
		{label && <title id={titleId}>{label}</title>}
		<Fragment set:html={markup} />
	</svg>
)}
