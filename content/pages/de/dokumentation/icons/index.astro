---
import DocumentationLayout from '@template/layouts/documentation/DocumentationLayout.astro';
import IconGallery from '@template/components/IconGallery/IconGallery.astro';

// eslint-disable-next-line astro/no-exports-from-components -- Exported for ChildPageOverview glob
export const frontmatter: DocumentationFrontMatter = {
	layout: '@template/layouts/documentation',
	sectionSpacing: 'small',
	sectionWidth: 'auto',
	headline: 'Icons',
	title: 'Icons',
	description:
		'Durchsuche alle DB UX Icons, sieh sie in jeder Größe und Family an und kopiere ihre Namen für die Verwendung im Code.',
	align: 'start',
	order: 4,
};
---

<DocumentationLayout frontmatter={frontmatter} headings={[]}>
	<IconGallery lang="de" />
</DocumentationLayout>
