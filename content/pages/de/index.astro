---
import PageHeroSection from '@components/home/PageHeroSection.astro';
import InteractiveDemoSection from '@components/home/InteractiveDemoSection.astro';
import PackagesSection from '@components/home/PackagesSection.astro';
import DesignedForSection from '@components/home/DesignedForSection.astro';
import TestimonialsSection from '@components/home/TestimonialsSection.astro';
import { ContactUsSection } from '@components';
import DefaultLayout from '@template/layouts/default';
---

<DefaultLayout frontmatter={{}}>
	<PageHeroSection headline="für herausragende digitale Produkte" startLabel="Jetzt starten" />

	<InteractiveDemoSection
		darkModeLabel="Dark Mode aktivieren"
		lightModeLabel="Light Mode aktivieren"
		fullscreenLabel="Vollbild"
		demoTitle="Interaktive Demo"
		themeLabel="Theme"
		showB2CLabel="B2C-Demo anzeigen"
		showB2BLabel="B2B-Demo anzeigen"
	/>

	<PackagesSection
		sectionTitle="Ein Design System für alle"
		sectionDescription="Das Design System befähigt alle Teams der DB, ihre digitalen Produkte konsistent, effizient und nutzerorientiert umzusetzen."
		foundationTitle="Foundation"
		foundationText="Designgrundlagen schaffen die Basis für ein einheitliches Nutzererlebnis."
		componentsTitle="Komponenten"
		componentsText="Wiederverwendbare Komponenten bilden die Grundlage für einheitliche Benutzeroberflächen."
		extensionsTitle="Erweiterungen"
		extensionsText="Fachspezifische Komponenten erweitern das Design System für besondere Anwendungsfälle."
		patternsTitle="Patterns"
		patternsText="Wiederverwendbare Interaktionsmodelle für konsistentes Verhalten über alle Produkte hinweg."
		templatesTitle="Templates"
		templatesText="Strukturierte Ausgangspunkte beschleunigen die Seitenerstellung und sorgen für konsistente Layouts."
		comingSoonLabel="Demnächst verfügbar"
	/>

	<DesignedForSection
		sectionTitle="So unterstützt das System deine Arbeit"
		sectionDescription="Das Design System hilft dir, digitale Produkte einfacher, planbarer und schneller umzusetzen."
		pmTitle="Schneller entscheiden"
		pmText="Gemeinsame Standards vermeiden Mehraufwand und wiederkehrende Diskussionen."
		pmTag="Für Produktmanagement"
		devTitle="Einfacher entwickeln"
		devText="Updates und Änderungen lassen sich frühzeitig planen und effizient umsetzen."
		devTag="Für Entwickler:innen"
		designTitle="Flexibel anpassen"
		designText="Produkte lassen sich unterschiedlichen Anforderungen anpassen und bleiben konsistent."
		designTag="Für Designer:innen"
		pmVisualLabel="Zeitplan mit verkürzten Phasen für schnellere Lieferzyklen"
		devVisualLabel="Versionsverlauf mit Release-Typen für planbare Wartung"
		designVisualLabel="Button-Playground mit Einstellungen für Variante, Text, Icon-Anzeige und Icon"
	/>

	<TestimonialsSection
		quote1={`„Seit wir das System nutzen, verbringen unsere Teams weniger Zeit mit UI-Abstimmungen und mehr mit echten Produktproblemen.“`}
		quote2={`„Neue Teammitglieder werden schneller produktiv, weil das System erklärt, wie wir unsere Produkte gestalten und entwickeln.“`}
		quote3={`„Design und Entwicklung sprechen endlich die gleiche Sprache – die Übergabe ist planbar statt jedes Mal neu.“`}
	/>

	<ContactUsSection />
</DefaultLayout>

<script>
	import '@template/utils/home-demo.client.ts';
</script>
